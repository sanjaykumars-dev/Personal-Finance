# Optional: accounts + cloud sync via Supabase (see README → "Accounts & cloud sync").
# Leave these empty to run local-only (data in the browser, no login).
#
# Supabase → Project Settings → API (Data API) → Project URL and the anon / publishable key.
# The anon key is public by design; Row Level Security protects the data.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional OAuth buttons on the login page (enable them in Supabase → Authentication → Providers first).
# Comma-separated: google,github
VITE_AUTH_PROVIDERS=
